<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Console subsystem, not WinExe. The overlay still shows, and stdout stays useful
      while testing. In production the watchdog launches with CREATE_NO_WINDOW
      (ShowAgentWindow: false), so no console window appears either way.
    -->
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlaySlot.Agent</RootNamespace>
    <AssemblyName>PlaySlot.Agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- See the note in PlaySlot.Watchdog.csproj. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
